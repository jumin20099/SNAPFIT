{
  "name": "snapfit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "start:e2e": "npm run build && npm run start",
    "analyze": "ANALYZE=true npm run build",
    "lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html",
    "sentry:sourcemaps": "sentry-cli releases files upload-sourcemaps .next/static",
    "generate:api": "openapi-generator-cli generate -i http://localhost:8080/v3/api-docs -g typescript-fetch -o src/generated/api --additional-properties=supportsES6=true,typescriptThreePlus=true",
    "generate:api:local": "openapi-generator-cli generate -i http://localhost:8080/v3/api-docs -g typescript-fetch -o src/generated/api --additional-properties=supportsES6=true,typescriptThreePlus=true",
    "generate:api:prod": "openapi-generator-cli generate -i https://api.snapfit.app/v3/api-docs -g typescript-fetch -o src/generated/api --additional-properties=supportsES6=true,typescriptThreePlus=true",
    "dev:start": "./scripts/dev-start.sh",
    "dev:full": "concurrently \"npm run dev:start\" \"npm run test:watch\""
  },
  "proxy": "http://localhost:8080",
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@sentry/nextjs": "^10.8.0",
    "@stomp/stompjs": "^7.1.1",
    "@tanstack/react-query": "^5.85.8",
    "@tanstack/react-query-devtools": "^5.85.8",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "jose": "^6.0.12",
    "lucide-react": "^0.511.0",
    "next": "^14.1.0",
    "next-themes": "^0.4.6",
    "openapi-generator-cli": "^1.0.0",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "sockjs-client": "^1.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.2",
    "@openapitools/openapi-generator-cli": "^2.23.0",
    "@playwright/test": "^1.42.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^30.1.2",
    "jest-environment-jsdom": "^30.1.2",
    "msw": "^2.11.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5"
  }
}
