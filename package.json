{
  "name": "snapfit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "start:e2e": "npm run build && npm run start",    "generate:api": "openapi-generator-cli generate -i http://localhost:8080/v3/api-docs -g typescript-fetch -o src/generated/api --additional-properties=supportsES6=true,typescriptThreePlus=true",
    "generate:api:local": "openapi-generator-cli generate -i http://localhost:8080/v3/api-docs -g typescript-fetch -o src/generated/api --additional-properties=supportsES6=true,typescriptThreePlus=true",
    "generate:api:prod": "openapi-generator-cli generate -i https://api.snapfit.app/v3/api-docs -g typescript-fetch -o src/generated/api --additional-properties=supportsES6=true,typescriptThreePlus=true",
    "start:e2e": "npm run build && npm run start",
    "dev:start": "./scripts/dev-start.sh",
    "dev:full": "concurrently \"npm run dev:start\" \"npm run test:watch\""
  },
  "proxy": "http://localhost:8080",
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@stomp/stompjs": "^7.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@openapitools/openapi-generator-cli": "^2.22.0",
    "@playwright/test": "^1.42.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/jest": "^29.5.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sockjs-client": "^1.5.4",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5"
  }
}
